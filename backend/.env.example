# ===== FoodTime backend environment variables =====

# App environment: test | production
APP_ENV=test

# JWT signing secret. Leaving it unset falls back to an insecure dev
# default in config.py, so override it for anything but local dev:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-me-with-a-random-48-char-string

# Database engine: mysql | sqlite
# config.py default is sqlite (that is what the test suite runs on);
# local docker-compose and cloud deployments use mysql.
DB_TYPE=mysql

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=Gourmet_House_test

# SQLAlchemy connection pool (values are the config.py defaults). Worth tuning
# for a cloud MySQL instance: DB_POOL_RECYCLE must stay BELOW the server's
# wait_timeout, otherwise the pool hands out connections the server already
# closed and the first request after an idle period fails.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# LLM: DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Daily LLM chat quota per user (config.py default: 10)
LLM_CHAT_QUOTA=10

# LLM: Qwen / DashScope (https://dashscope.console.aliyun.com)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-plus

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Extra CORS rule: a regex fragment matched against the Origin header, so
# preview deploys such as *.<project>.vercel.app work without listing every
# origin. Empty (default) = disabled.
CORS_ORIGIN_REGEX=
